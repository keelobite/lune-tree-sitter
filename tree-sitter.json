{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lune",
      "camelcase": "Lune",
      "title": "Lune",
      "scope": "source.lune",
      "file-types": [
        "nn"
      ],
      "injection-regex": "^lune$",
      "class-name": "TreeSitterLune",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Lune grammar for tree-sitter",
    "authors": [
      {
        "name": "ff",
        "email": "ff",
        "url": "ff"
      }
    ]
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
